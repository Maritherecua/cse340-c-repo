<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/users">View Registered Users</a></p>
            <% } %>

                <section class="dashboard-volunteer-projects">
                    <h3>Your Volunteer Projects</h3>

                    <% if (volunteeredProjects && volunteeredProjects.length> 0) { %>
                        <ul>
                            <% volunteeredProjects.forEach((project)=> { %>
                                <li>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                    <% if (project.date) { %>
                                        - <%= new Date(project.date).toLocaleDateString('en-US', { month: 'short' ,
                                            day: 'numeric' , year: 'numeric' }) %>
                                            <% } %>
                                                - <form action="/dashboard/unvolunteer/<%= project.project_id %>"
                                                    method="POST" style="display:inline;">
                                                    <button type="submit">Remove</button>
                                                </form>
                                </li>
                                <% }) %>
                        </ul>
                        <% } else { %>
                            <p>You have not signed up to volunteer for any projects yet.</p>
                            <% } %>
                </section>

    </main>

    <%- include('partials/footer') %>