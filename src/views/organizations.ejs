<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
        <ul>
            <% organizations.forEach(organization=> { %>
                <li> 
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a>: <%= organization.contact_email %>
                </li>
                <% }); %>
        </ul>
        <% if (user && user.is_admin) { %>
            <p><a href="/new-organization">Add a new organization</a></p>
        <% } %>
    <!-- <p><a href="/new-organization">Add a new organization</a></p> -->
    </main>
    <%- include('partials/footer') %>