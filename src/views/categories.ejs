<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (user && user.role_name === 'admin') { %>
            <a href="/new-category">Add a new category</a>
            <% } %>
                <ul>
                    <% categories.forEach(category=> { %>
                        <li>
                            <!-- Wrap the category name in a link pointing to the details page -->
                            <a href="/category/<%= category.category_id %>"
                                <%= category.name %>
                            </a>
                            <% if (user && user.role_name === 'admin') { %>
                                <span> - </span>
                                <a href="/edit-category/<%= category.category_id %>">Edit</a>
                                <% } %>
                        </li>
                        <% }) %>
                </ul>
    </main>
    <%- include('partials/footer') %>